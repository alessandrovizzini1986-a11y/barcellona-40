# Regole di cache lette da Cloudflare Pages (copiate così come sono in dist/).
# GitHub Pages le ignora: lì la difesa è che i dati stanno dentro il bundle con hash
# nel nome, quindi una ricarica non può mai servire dati vecchi insieme a codice nuovo.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: no-cache, must-revalidate
